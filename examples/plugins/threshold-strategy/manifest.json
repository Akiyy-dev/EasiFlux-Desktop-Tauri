{
  "schemaVersion": 6,
  "id": "com.easiflux.examples.threshold-strategy",
  "publisherId": "com.easiflux.examples",
  "publisher": "EasiFlux example (unverified)",
  "name": "Threshold-once strategy example",
  "description": "Execution demo that requests one configured limit order at a price threshold, then cancels that owned active order once and stops.",
  "version": "1.0.0",
  "contributions": [
    {
      "kind": "command",
      "contributionId": "strategy.threshold-once",
      "title": "Run threshold-once execution demo",
      "actionId": "sandbox.strategy",
      "params": {
        "runtime": "wasm-v1",
        "abi": "strategy-json-v1",
        "moduleBase64": "",
        "defaultInput": "{\"threshold\":\"100\",\"order\":{\"symbol\":\"BTCUSDT\",\"side\":\"Buy\",\"orderType\":\"Limit\",\"qty\":\"0.001\",\"price\":\"100\",\"timeInForce\":\"GTC\",\"positionIdx\":1,\"reduceOnly\":false}}"
      }
    }
  ],
  "requestedCapabilities": [
    "account.read",
    "orders.read",
    "market.read",
    "trade.place",
    "trade.cancel",
    "strategy.run"
  ]
}
